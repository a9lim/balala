#!/usr/bin/env python3
"""balala: modded Balatro on macOS in one command.

  balala                        launch Balatro with lovely (runs setup first if needed)
  balala setup   [-s|-l]        install lovely, Steamodded and Amulet
  balala install URL... [-s|-l] install mods from GitHub repos, git URLs or .zip links
  balala update  [-s|-l]        update lovely, Steamodded, Amulet and every installed mod
  balala list                   show what's installed
  balala remove NAME...         remove mods

-l/--latest (the default) tracks the default branch's HEAD; -s/--stable pins
the newest published release. Anything that needs compiling (lovely) is
release-only, so it ignores the flag.

Stdlib only, so any python3 >= 3.9 runs it.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
import zipfile
from contextlib import contextmanager
from dataclasses import dataclass
from pathlib import Path

LOVELY_REPO = "ethangreen-dev/lovely-injector"
CORE = {  # folder in Mods/ -> GitHub repo, installed by `setup`
    "smods": "Steamodded/smods",
    "amulet": "frostice482/amulet",
}
ARCHIVE_EXTS = (".zip", ".tar.gz", ".tgz")

HOME = Path.home()
STEAM_DIR = HOME / "Library/Application Support/Steam"
MODS_DIR = Path(os.environ.get("BALALA_MODS_DIR") or HOME / "Library/Application Support/Balatro/Mods")
STATE_DIR = HOME / "Library/Application Support/balala"
STATE_FILE = STATE_DIR / "state.json"
BACKUP_DIR = STATE_DIR / "backups"
CACHE_DIR = HOME / "Library/Caches/balala"

STATE: dict = {}


# ── output ────────────────────────────────────────────────────────────────

_TTY = sys.stderr.isatty()


def _c(code: str, s: str) -> str:
    return f"\033[{code}m{s}\033[0m" if _TTY else s


def step(msg: str) -> None:
    print(f"{_c('1;34', '==>')} {_c('1', msg)}", file=sys.stderr)


def info(msg: str) -> None:
    print(f"    {msg}", file=sys.stderr)


def warn(msg: str) -> None:
    print(f"{_c('1;33', 'warning:')} {msg}", file=sys.stderr)


class Fail(Exception):
    pass


def die(msg: str):
    raise Fail(msg)


# ── state ─────────────────────────────────────────────────────────────────

def load_state() -> dict:
    try:
        state = json.loads(STATE_FILE.read_text())
    except FileNotFoundError:
        state = {}
    state.setdefault("lovely", None)
    state.setdefault("mods", {})
    return state


def save_state() -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE_FILE.with_name(STATE_FILE.name + ".tmp")
    tmp.write_text(json.dumps(STATE, indent=2, sort_keys=True) + "\n")
    os.replace(tmp, STATE_FILE)


def now() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")


# ── network ───────────────────────────────────────────────────────────────

_token: str | None = None


def github_token() -> str | None:
    """GITHUB_TOKEN / GH_TOKEN, else `gh auth token`; lifts the 60 req/h anonymous limit."""
    global _token
    if _token is None:
        _token = os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN") or ""
        if not _token and shutil.which("gh"):
            r = subprocess.run(["gh", "auth", "token"], capture_output=True, text=True)
            _token = r.stdout.strip() if r.returncode == 0 else ""
    return _token or None


def _open(url: str, headers: dict | None = None):
    req = urllib.request.Request(url, headers={"User-Agent": "balala", **(headers or {})})
    return urllib.request.urlopen(req, timeout=120)


def api(path: str):
    """GET a GitHub API path; None on 404. The token only ever goes to api.github.com."""
    global _token
    headers = {"Accept": "application/vnd.github+json", "X-GitHub-Api-Version": "2022-11-28"}
    token = github_token()
    if token:
        headers["Authorization"] = f"Bearer {token}"
    try:
        with _open(f"https://api.github.com/{path}", headers) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return None
        if e.code == 401 and token:
            _token = ""  # stale token: retry anonymously
            return api(path)
        if e.code in (403, 429) and e.headers.get("X-RateLimit-Remaining") == "0":
            die("GitHub API rate limit hit; run `gh auth login` or set GITHUB_TOKEN")
        die(f"GitHub API {path}: HTTP {e.code}")
    except urllib.error.URLError as e:
        die(f"can't reach GitHub ({e.reason})")


def download(url: str, dest: Path) -> None:
    try:
        with _open(url) as r, open(dest, "wb") as f:
            shutil.copyfileobj(r, f)
    except urllib.error.HTTPError as e:
        die(f"download failed: {url} (HTTP {e.code})")
    except urllib.error.URLError as e:
        die(f"download failed: {url} ({e.reason})")


def newest_release(repo: str) -> dict | None:
    """GitHub's 'latest' release; failing that (repo only has prereleases), the newest published one."""
    rel = api(f"repos/{repo}/releases/latest")
    if rel:
        return rel
    rels = [r for r in (api(f"repos/{repo}/releases?per_page=20") or []) if not r.get("draft")]
    return rels[0] if rels else None


# ── files ─────────────────────────────────────────────────────────────────

@contextmanager
def staging():
    """A scratch dir on the same volume as Mods/, so the final move is a rename."""
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    d = Path(tempfile.mkdtemp(prefix="stage-", dir=CACHE_DIR))
    try:
        yield d
    finally:
        shutil.rmtree(d, ignore_errors=True)


def fetch_archive(url: str, tmp: Path) -> tuple[Path, str]:
    """Download and unpack an archive; return (mod root, sha256 of the archive)."""
    arc = tmp / "download"
    download(url, arc)
    digest = hashlib.sha256(arc.read_bytes()).hexdigest()
    out = tmp / "unpacked"
    out.mkdir()
    if zipfile.is_zipfile(arc):
        with zipfile.ZipFile(arc) as z:
            z.extractall(out)  # zipfile strips absolute paths and '..'
    else:
        try:
            with tarfile.open(arc) as t:
                if hasattr(tarfile, "data_filter"):
                    t.extractall(out, filter="data")
                else:
                    t.extractall(out)
        except tarfile.TarError:
            die(f"{url} is neither a zip nor a tarball")
    # GitHub source archives wrap everything in one folder; release zips often don't.
    entries = [p for p in out.iterdir() if p.name not in ("__MACOSX", ".DS_Store")]
    if len(entries) == 1 and entries[0].is_dir():
        return entries[0], digest
    return out, digest


def backup(path: Path) -> Path:
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    dest = BACKUP_DIR / f"{path.name}-{time.strftime('%Y%m%d-%H%M%S')}"
    shutil.move(str(path), str(dest))
    return dest


def clear_target(target: Path, rec: dict | None) -> None:
    """Make room for a new install. Deletes balala's own copies; anything that
    might hold someone's work (an unmanaged folder, a clone with local edits or
    commits) is moved to backups instead."""
    pristine = rec.get("ref") if rec and rec.get("kind") == "git" else None
    if target.is_symlink():
        target.unlink()
    elif target.exists():
        if rec is not None and not git_has_local_work(target, pristine):
            shutil.rmtree(target)
        else:
            warn(f"moved existing {target.name} to {backup(target)}")


# ── git ───────────────────────────────────────────────────────────────────

def git(*args: str, cwd: Path | None = None, check: bool = True) -> str:
    if not shutil.which("git"):
        die("git not found (xcode-select --install)")
    env = {**os.environ, "GIT_TERMINAL_PROMPT": "0"}  # fail, don't prompt, on missing/private repos
    r = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True, env=env)
    if check and r.returncode != 0:
        die(f"git {args[0]} failed: {r.stderr.strip() or r.stdout.strip()}")
    return r.stdout.strip()


def is_clone(path: Path) -> bool:
    return (path / ".git").exists()


def git_dirty(path: Path) -> bool:
    return bool(git("status", "--porcelain", "--untracked-files=no", cwd=path, check=False))


def git_has_local_work(path: Path, pristine: str | None = None) -> bool:
    """Uncommitted edits, or commits that aren't upstream's. A clone still at
    `pristine` (the commit balala put there) has no local commits by definition,
    even if upstream has since rewritten history."""
    if not is_clone(path):
        return False
    if git_dirty(path):
        return True
    if pristine and git("rev-parse", "HEAD", cwd=path, check=False) == pristine:
        return False
    ahead = git("rev-list", "--count", "@{u}..HEAD", cwd=path, check=False)
    return ahead.isdigit() and int(ahead) > 0


def norm_remote(url: str) -> str:
    u = url.strip().lower()
    u = re.sub(r"^git@github\.com:", "https://github.com/", u)
    u = re.sub(r"^(https?://)(www\.)?", "https://", u)
    u = u.rstrip("/")
    return u[:-4] if u.endswith(".git") else u


def same_remote(a: str | None, b: str | None) -> bool:
    return bool(a and b) and norm_remote(a) == norm_remote(b)


def short(sha: str) -> str:
    return sha[:7]


# ── sources ───────────────────────────────────────────────────────────────

@dataclass
class Source:
    url: str
    kind: str  # "github" | "git" | "archive"
    name: str  # default folder name in Mods/
    repo: str | None = None  # owner/name, for GitHub
    branch: str | None = None


def parse_source(link: str) -> Source:
    s = link.strip()
    if re.fullmatch(r"[A-Za-z0-9-]+/[\w.-]+", s) and not s.lower().endswith(ARCHIVE_EXTS):
        s = "https://github.com/" + s  # owner/repo shorthand (GitHub owners can't contain dots)
    s = re.sub(r"^git@github\.com:", "https://github.com/", s)
    if re.match(r"^(www\.)?github\.com/", s):
        s = "https://" + s
    u = urllib.parse.urlparse(s)
    host = u.netloc.lower()
    segs = [p for p in u.path.split("/") if p]

    if u.scheme in ("http", "https") and u.path.lower().endswith(ARCHIVE_EXTS):
        if host in ("github.com", "www.github.com") and len(segs) >= 2:
            name = segs[1]  # e.g. a release asset: name it after the repo
        else:
            name = re.sub(r"(\.zip|\.tar\.gz|\.tgz)$", "", segs[-1], flags=re.I)
        return Source(s, "archive", name)

    if host in ("github.com", "www.github.com"):
        if len(segs) < 2:
            die(f"not a GitHub repo link: {link}")
        owner, repo = segs[0], segs[1]
        repo = repo[:-4] if repo.endswith(".git") else repo
        branch = "/".join(segs[3:]) if len(segs) > 3 and segs[2] == "tree" else None
        return Source(f"https://github.com/{owner}/{repo}", "github", repo, f"{owner}/{repo}", branch)

    if u.scheme in ("http", "https", "ssh", "git", "file") or re.match(r"^[\w.-]+@[\w.-]+:", s):
        tail = re.split(r"[/:]", s.rstrip("/"))[-1]
        return Source(s, "git", tail[:-4] if tail.endswith(".git") else tail)

    die(f"don't know how to install {link!r} (want a GitHub repo, git URL or .zip link)")


def source_for(name: str) -> Source:
    rec = STATE["mods"].get(name)
    if rec:
        src = parse_source(rec["source"])
        src.branch = rec.get("branch") or src.branch
        return src
    return parse_source(CORE[name])


def release_archive_url(repo: str, rel: dict) -> str:
    """A release's own zip asset if it has exactly one obvious one, else the tag's source zip."""
    zips = [a for a in rel.get("assets", []) if a["name"].lower().endswith(".zip")]
    if len(zips) > 1:
        stem = repo.split("/")[1].lower()
        zips = [a for a in zips if stem in a["name"].lower()]
    if len(zips) == 1:
        return zips[0]["browser_download_url"]
    tag = urllib.parse.quote(rel["tag_name"], safe="")
    return f"https://codeload.github.com/{repo}/zip/refs/tags/{tag}"


# ── mods ──────────────────────────────────────────────────────────────────

def describe(rec: dict | None) -> str | None:
    """How a recorded install reads in messages: a tag, branch@sha, or sha256:…"""
    if not rec:
        return None
    if rec["kind"] == "git":
        return f"{rec.get('on') or rec.get('branch') or 'HEAD'}@{short(rec['ref'])}"
    if rec["kind"] == "archive":
        return f"sha256:{rec['ref'][:7]}"
    return rec["ref"]


def record(name: str, src: Source, channel: str, kind: str, ref: str) -> None:
    rec = {
        "source": src.url,
        "branch": src.branch,  # what was asked for (None = default branch)
        "channel": channel,
        "kind": kind,
        "ref": ref,
        "updated": now(),
    }
    if kind == "git":  # what the clone is actually on, for display
        rec["on"] = git("rev-parse", "--abbrev-ref", "HEAD", cwd=MODS_DIR / name, check=False)
    STATE["mods"][name] = rec
    save_state()


def ensure_mod(src: Source, channel: str, name: str | None = None) -> None:
    """Install, update, or switch the channel of one mod. Idempotent."""
    name = name or src.name
    if name.lower() == "lovely":
        die("'lovely' is lovely's own folder in Mods/; pick another name with --name")
    MODS_DIR.mkdir(parents=True, exist_ok=True)
    target = MODS_DIR / name
    rec = STATE["mods"].get(name)
    if rec and not same_remote(rec["source"], src.url):
        warn(f"{name}: replacing {rec['source']} with {src.url}")

    if src.kind == "archive":
        return _install_archive(name, target, src, rec)
    if channel == "stable":
        if src.kind != "github":
            warn(f"{name}: releases are only known for GitHub repos; tracking HEAD instead")
        elif src.branch:
            warn(f"{name}: a /tree/{src.branch} link means a branch; tracking its HEAD instead")
        else:
            rel = newest_release(src.repo)
            if rel:
                return _install_release(name, target, src, rel, rec)
            warn(f"{name}: {src.repo} has no releases; tracking HEAD instead")
    return _install_git(name, target, src, rec)


def _install_archive(name, target, src, rec) -> None:
    with staging() as tmp:
        root, digest = fetch_archive(src.url, tmp)
        if rec and rec.get("ref") == digest and target.is_dir():
            info(f"{name}: up to date")
            return
        clear_target(target, rec)
        shutil.move(str(root), str(target))
    step(f"{name}: installed {src.url}")
    record(name, src, "latest", "archive", digest)


def _install_release(name, target, src, rel, rec) -> None:
    tag = rel["tag_name"]
    if rec and rec.get("kind") == "release" and rec.get("ref") == tag and target.is_dir() and same_remote(rec["source"], src.url):
        info(f"{name}: {tag} (up to date)")
        return
    was = describe(rec)
    with staging() as tmp:
        root, _ = fetch_archive(release_archive_url(src.repo, rel), tmp)
        clear_target(target, rec)
        shutil.move(str(root), str(target))
    step(f"{name}: {(was + ' → ') if was else ''}{tag}")
    record(name, src, "stable", "release", tag)


def _install_git(name, target, src, rec) -> None:
    if is_clone(target) and same_remote(git("remote", "get-url", "origin", cwd=target, check=False), src.url):
        on = git("rev-parse", "--abbrev-ref", "HEAD", cwd=target, check=False)
        if not src.branch or on == src.branch:
            if rec is None:
                info(f"{name}: adopting the existing clone in Mods/")
            pristine = rec.get("ref") if rec and rec.get("kind") == "git" else None
            ref = _git_sync(name, target, pristine)
            record(name, src, "latest", "git", ref)
            return
    was = describe(rec)
    with staging() as tmp:
        dest = tmp / name
        args = ["clone", "--quiet", "--depth", "1"]
        if src.branch:
            args += ["--branch", src.branch]
        try:
            git(*args, src.url, str(dest))
        except Fail:
            if src.repo and api(f"repos/{src.repo}") is None:
                die(f"no such GitHub repo (or it's private): {src.url}")
            raise
        clear_target(target, rec)
        shutil.move(str(dest), str(target))
    ref = git("rev-parse", "HEAD", cwd=target)
    branch = git("rev-parse", "--abbrev-ref", "HEAD", cwd=target, check=False)
    step(f"{name}: {(was + ' → ') if was else ''}{branch}@{short(ref)}")
    record(name, src, "latest", "git", ref)


def _git_sync(name: str, path: Path, pristine: str | None) -> str:
    """Fast-forward a clone to its upstream. If upstream was rewritten, reset only
    when the clone is exactly what balala left there; never discard local work."""
    git("fetch", "--quiet", "origin", cwd=path)
    head = git("rev-parse", "HEAD", cwd=path)
    up = git("rev-parse", "@{u}", cwd=path)
    branch = git("rev-parse", "--abbrev-ref", "HEAD", cwd=path, check=False)
    if head == up:
        info(f"{name}: {branch}@{short(head)} (up to date)")
        return head
    ff = subprocess.run(["git", "merge-base", "--is-ancestor", head, up], cwd=path).returncode == 0
    if ff and not git_dirty(path):
        git("merge", "--ff-only", "--quiet", up, cwd=path)
    elif head == pristine and not git_dirty(path):
        git("reset", "--hard", "--quiet", up, cwd=path)
        info(f"{name}: upstream history was rewritten; reset to it")
    else:
        warn(f"{name}: local changes or commits; left at {short(head)} "
             f"(commit or discard them, or `balala remove {name}` and reinstall)")
        return head
    step(f"{name}: {short(head)} → {branch}@{short(up)}")
    return up


# ── mod metadata (for dependency warnings) ────────────────────────────────

def mod_headers(folder: Path) -> list[dict]:
    """Steamodded JSON headers at the top of a mod folder."""
    out = []
    for p in sorted(folder.glob("*.json")):
        try:
            d = json.loads(p.read_text(encoding="utf-8-sig"))
        except (OSError, ValueError):
            continue
        if isinstance(d, dict) and isinstance(d.get("id"), str) and "main_file" in d:
            out.append(d)
    return out


def _dep_id(spec: str) -> str:
    return str(spec).split("(")[0].strip().lower()


def installed_ids() -> set[str]:
    ids = {"balatro"}
    if STATE.get("lovely"):
        ids.add("lovely")
    if not MODS_DIR.is_dir():
        return ids
    for d in MODS_DIR.iterdir():
        if not d.is_dir() or d.name.startswith(".") or d.name == "lovely":
            continue
        if (d / "version.lua").is_file() and (d / "src").is_dir() and (d / "lovely").is_dir():
            ids.add("steamodded")  # smods has no JSON header of its own
        for h in mod_headers(d):
            ids.add(h["id"].lower())
            ids.update(_dep_id(p) for p in h.get("provides") or [])
        for lua in d.glob("*.lua"):  # old-style "--- MOD_ID:" headers
            try:
                head = lua.read_text(errors="replace")[:2000]
            except OSError:
                continue
            m = re.search(r"^--- MOD_ID:\s*(\S+)", head, re.M)
            if m:
                ids.add(m.group(1).lower())
    return ids


def check_deps(name: str) -> None:
    have = installed_ids()
    for h in mod_headers(MODS_DIR / name):
        missing = [dep for dep in h.get("dependencies") or []
                   if not any(_dep_id(alt) in have for alt in str(dep).split("|"))]
        if missing:
            warn(f"{h['id']} also needs {', '.join(missing)}, which isn't installed")


# ── lovely ────────────────────────────────────────────────────────────────

def game_dir() -> Path:
    env = os.environ.get("BALALA_GAME_DIR")
    if env:
        g = Path(env).expanduser()
        if not (g / "Balatro.app").is_dir():
            die(f"BALALA_GAME_DIR={env} has no Balatro.app")
        return g
    libs = [STEAM_DIR]
    try:
        vdf = (STEAM_DIR / "steamapps/libraryfolders.vdf").read_text(errors="replace")
        libs += [Path(p) for p in re.findall(r'"path"\s+"([^"]+)"', vdf)]
    except OSError:
        pass
    for lib in libs:
        g = lib / "steamapps/common/Balatro"
        if (g / "Balatro.app").is_dir():
            return g
    die("can't find Balatro.app in your Steam libraries (set BALALA_GAME_DIR to its folder)")


def lovely_present(game: Path) -> bool:
    return (game / "liblovely.dylib").is_file() and (game / "run_lovely_macos.sh").is_file()


def mac_arch() -> str:
    # By hardware, not by this interpreter (which might run under Rosetta).
    r = subprocess.run(["sysctl", "-n", "hw.optional.arm64"], capture_output=True, text=True)
    return "aarch64" if r.stdout.strip() == "1" else "x86_64"


def ensure_lovely(channel: str) -> None:
    """lovely is compiled Rust, so it's release-only whatever the channel."""
    game = game_dir()
    rel = newest_release(LOVELY_REPO) or die("lovely has no releases?")
    tag = rel["tag_name"]
    rec = STATE.get("lovely")
    note = " — lovely is release-only" if channel == "latest" else ""
    if rec and rec.get("ref") == tag and lovely_present(game):
        info(f"lovely: {tag} (up to date{note})")
        return
    asset_name = f"lovely-{mac_arch()}-apple-darwin.tar.gz"
    asset = next((a for a in rel["assets"] if a["name"] == asset_name), None)
    if not asset:
        die(f"lovely {tag} has no {asset_name}")
    with staging() as tmp:
        arc = tmp / asset_name
        download(asset["browser_download_url"], arc)
        out = tmp / "unpacked"
        out.mkdir()
        with tarfile.open(arc) as t:
            if hasattr(tarfile, "data_filter"):
                t.extractall(out, filter="data")
            else:
                t.extractall(out)
        for fname in ("liblovely.dylib", "run_lovely_macos.sh"):
            src = next(out.rglob(fname), None) or die(f"{asset_name} is missing {fname}")
            # Write beside the target, then rename: a running game keeps its old copy.
            part = game / f".{fname}.balala-part"
            shutil.copyfile(src, part)
            os.chmod(part, 0o755)
            os.replace(part, game / fname)
    was = rec.get("ref") if rec else None
    if was == tag:
        step(f"lovely: reinstalled {tag}")
    else:
        step(f"lovely: {(was + ' → ') if was else ''}{tag}{note}")
    STATE["lovely"] = {"ref": tag, "updated": now()}
    save_state()


# ── commands ──────────────────────────────────────────────────────────────

def run_all(jobs) -> int:
    """Run (label, fn) jobs, carrying on past failures; returns the failure count."""
    failed = 0
    for label, fn in jobs:
        try:
            fn()
        except Fail as e:
            failed += 1
            print(f"{_c('1;31', 'error:')} {label}: {e}", file=sys.stderr)
    return failed


def core_jobs(channel: str, only: list[str] | None = None):
    names = only if only is not None else ["lovely", *CORE]
    for n in names:
        if n == "lovely":
            yield "lovely", lambda: ensure_lovely(channel)
        else:
            yield n, (lambda n=n: ensure_mod(source_for(n), channel, n))


def cmd_setup(channel: str) -> int:
    failed = run_all(core_jobs(channel))
    if not failed:
        STATE["setup"] = now()  # from here on, a removed core mod stays removed
        save_state()
    return failed


def cmd_install(links: list[str], channel: str, name: str | None) -> int:
    if name and len(links) > 1:
        die("--name only works with a single link")
    installed = []

    def job(link):
        src = parse_source(link)
        ensure_mod(src, channel, name)
        installed.append(name or src.name)

    failed = run_all((link, lambda link=link: job(link)) for link in links)
    for n in installed:
        check_deps(n)
    return failed


def cmd_update(channel: str) -> int:
    if not STATE.get("setup"):
        failed = cmd_setup(channel)
    else:  # core mods you've removed stay removed
        failed = run_all(core_jobs(channel, only=["lovely", *(n for n in CORE if n in STATE["mods"])]))
    extra = [n for n in STATE["mods"] if n not in CORE]
    return failed + run_all((n, lambda n=n: ensure_mod(source_for(n), channel, n)) for n in extra)


def unmanaged_dirs() -> list[str]:
    if not MODS_DIR.is_dir():
        return []
    return sorted(d.name for d in MODS_DIR.iterdir()
                  if d.is_dir() and not d.name.startswith(".") and d.name != "lovely" and d.name not in STATE["mods"])


def cmd_list() -> int:
    rows = []
    lov = STATE.get("lovely")
    rows.append(("lovely", "release", lov["ref"] if lov else "not installed", LOVELY_REPO))
    for n in [*CORE, *sorted(k for k in STATE["mods"] if k not in CORE)]:
        rec = STATE["mods"].get(n)
        if not rec:
            rows.append((n, "", "not installed", CORE.get(n, "")))
            continue
        ref = describe(rec)
        if not (MODS_DIR / n).is_dir():
            ref += " (missing!)"
        rows.append((n, rec["channel"], ref, rec["source"].removeprefix("https://github.com/")))
    for n in unmanaged_dirs():
        rows.append((n, "unmanaged", "", ""))
    w = [max(len(r[i]) for r in rows) for i in range(3)]
    for r in rows:
        print(f"{r[0]:<{w[0]}}  {r[1]:<{w[1]}}  {r[2]:<{w[2]}}  {r[3]}".rstrip())
    return 0


def cmd_remove(names: list[str]) -> int:
    def job(query):
        candidates = list(STATE["mods"]) + unmanaged_dirs()
        hit = next((c for c in candidates if c == query), None) or \
            next((c for c in candidates if c.lower() == query.lower()), None)
        if not hit:
            die("no such mod (see `balala list`)")
        target = MODS_DIR / hit
        if target.exists() or target.is_symlink():
            clear_target(target, STATE["mods"].get(hit))
        STATE["mods"].pop(hit, None)
        save_state()
        step(f"removed {hit}")
        if hit in CORE:
            info("it's part of setup; `balala setup` brings it back")

    return run_all((n, lambda n=n: job(n)) for n in names)


def cmd_launch(args: list[str]) -> int:
    game = game_dir()
    if not STATE.get("setup"):
        step("first run: setting up lovely, smods and amulet")
        if cmd_setup("latest"):
            die("setup failed; not launching")
    elif not lovely_present(game):  # e.g. a Steam reinstall wiped it; can't launch without it
        ensure_lovely("stable")
    step("launching Balatro with lovely")
    sys.stderr.flush()
    script = game / "run_lovely_macos.sh"
    # The stock script cd's into the default Steam library; use it whenever that's where the game is.
    default = Path(f"/Users/{os.environ.get('USER', '')}/Library/Application Support/Steam/steamapps/common/Balatro")
    if default.exists() and game.resolve() == default.resolve():
        os.execv("/bin/bash", ["/bin/bash", str(script), *args])
    os.chdir(game)
    os.environ["DYLD_INSERT_LIBRARIES"] = "liblovely.dylib"
    love = game / "Balatro.app/Contents/MacOS/love"
    try:
        os.execv(str(love), [str(love), *args])
    except OSError as e:
        die(f"couldn't start {love}: {e.strerror}")


# ── cli ───────────────────────────────────────────────────────────────────

def channel_flags(p: argparse.ArgumentParser) -> None:
    g = p.add_mutually_exclusive_group()
    g.add_argument("-s", "--stable", dest="channel", action="store_const", const="stable",
                   help="newest published release")
    g.add_argument("-l", "--latest", dest="channel", action="store_const", const="latest",
                   help="HEAD of the default branch (default)")
    p.set_defaults(channel="latest")


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(
        prog="balala",
        description="Modded Balatro on macOS. With no command, launches the game with lovely "
                    "(running setup first if needed).",
        epilog="lovely is compiled, so it always installs its newest release.",
    )
    sub = ap.add_subparsers(dest="cmd", metavar="command")
    p = sub.add_parser("setup", help="install lovely, Steamodded and Amulet")
    channel_flags(p)
    p = sub.add_parser("install", help="install mods from GitHub repos, git URLs or .zip links")
    p.add_argument("links", nargs="+", metavar="URL")
    p.add_argument("-n", "--name", help="folder name in Mods/ (default: the repo name)")
    channel_flags(p)
    p = sub.add_parser("update", help="update lovely, Steamodded, Amulet and every installed mod")
    channel_flags(p)
    sub.add_parser("list", help="show what's installed")
    p = sub.add_parser("remove", help="remove mods")
    p.add_argument("names", nargs="+", metavar="NAME")
    p = sub.add_parser("launch", help="launch the game (same as no command)")
    p.add_argument("args", nargs=argparse.REMAINDER, help="passed through to the game")

    a = ap.parse_args(argv)
    global STATE
    STATE = load_state()
    try:
        if a.cmd == "setup":
            return 1 if cmd_setup(a.channel) else 0
        if a.cmd == "install":
            return 1 if cmd_install(a.links, a.channel, a.name) else 0
        if a.cmd == "update":
            return 1 if cmd_update(a.channel) else 0
        if a.cmd == "list":
            return cmd_list()
        if a.cmd == "remove":
            return 1 if cmd_remove(a.names) else 0
        args = getattr(a, "args", None) or []
        return cmd_launch(args[1:] if args[:1] == ["--"] else args)
    except Fail as e:
        print(f"{_c('1;31', 'error:')} {e}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
